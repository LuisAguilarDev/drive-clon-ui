# Imagen de desarrollo del frontend React + Vite (hot-reload vía volumen)
FROM node:20-slim

WORKDIR /app

# Habilitar pnpm vía corepack (incluido en Node 20). La versión la fija el
# campo "packageManager" de package.json.
RUN corepack enable

# Instalar dependencias primero (mejor uso de la cache de capas)
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

# El código se monta como volumen en docker-compose; esta copia es para builds standalone
COPY . .

EXPOSE 5173

# El comando real lo define docker-compose; este es el fallback para `docker run`
CMD ["pnpm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]
