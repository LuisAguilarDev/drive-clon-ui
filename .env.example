# Frontend configuration (Vite exposes only VITE_-prefixed vars).
# Copy this file to `.env` and adjust for your environment.
#
# Auth is handled by Keycloak (OIDC). Google sign-in is federated *inside*
# Keycloak, so no Google/OAuth secret ever lives in the frontend.

# Backend API base URL
VITE_API_URL=http://localhost:8000

# Keycloak (OIDC) — public client, no secret here
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=driveclon
VITE_KEYCLOAK_CLIENT_ID=driveclon-ui
